<roblox version="4">
  <Item class="Folder" referent="0">
    <Properties>
      <string name="Name">LIGHTS</string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">Apparition</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Apparition.lua — la sagoma. Compare per pochissimi istanti in una postazione lontana da tutti i giocatori,
	di solito durante un blackout, e scompare sempre prima che le luci tornino.
	Rara per design: chance basse + cooldown globale. Tutti vedono la stessa sagoma (e' lato server).
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("LIGHTS")
local Config = require(shared:WaitForChild("Config"))
local Rules = require(shared:WaitForChild("Rules"))

local Apparition = {}

export type Spot = { name: string, position: Vector3, minDistance: number }

local rng: Random
local spots: { Spot } = {}
local folder: Instance
local lastShownAt: number? = nil
local generation = 0 -- aumenta a ogni clear: cancella le apparizioni gia' programmate
local current: Model? = nil

local SILHOUETTE = Color3.fromRGB(12, 12, 14)

-- Sagoma alta e sottile (circa 8 studs), leggermente piegata in avanti: niente volto, niente dettagli.
local function buildFigure(at: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Silhouette"

	local function piece(name: string, size: Vector3, cframe: CFrame)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = SILHOUETTE
		p.Transparency = 1
		p.Size = size
		p.CFrame = at * cframe
		p.Parent = model
	end

	piece("Legs", Vector3.new(1.4, 4.4, 0.8), CFrame.new(0, 2.2, 0))
	piece("Torso", Vector3.new(1.8, 4, 0.9), CFrame.new(0, 5.2, 0))
	piece("ArmL", Vector3.new(0.4, 4.8, 0.4), CFrame.new(-1.2, 4, 0))
	piece("ArmR", Vector3.new(0.4, 4.8, 0.4), CFrame.new(1.2, 4, 0))
	piece("Head", Vector3.new(1.1, 1.5, 1.0), CFrame.new(0, 7.6, 0.4) * CFrame.Angles(math.rad(-10), 0, 0))
	model.Parent = folder
	return model
end

local function clearFigure()
	if current then
		current:Destroy()
		current = nil
	end
end

-- Mostra la sagoma per "duration" secondi: fade-in, pausa, fade-out.
local function show(position: Vector3, duration: number, gen: number)
	if gen ~= generation then
		return
	end
	clearFigure()
	local model = buildFigure(CFrame.lookAt(position, Vector3.new(0, position.Y, 0)))
	current = model
	local fadeIn = TweenInfo.new(0.25, Enum.EasingStyle.Quad)
	local fadeOut = TweenInfo.new(0.3, Enum.EasingStyle.Quad)
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") then
			TweenService:Create(p, fadeIn, { Transparency = 0.1 }):Play()
		end
	end
	task.delay(duration, function()
		if current ~= model then
			return
		end
		for _, p in model:GetChildren() do
			if p:IsA("BasePart") then
				TweenService:Create(p, fadeOut, { Transparency = 1 }):Play()
			end
		end
		Debris:AddItem(model, 0.4)
		current = nil
	end)
end

-- Distanza minima tra la postazione e il giocatore piu' vicino, meno la distanza minima richiesta da quella postazione.
-- Valore >= 0 = postazione utilizzabile.
local function margins(spot: Spot): number
	local closest = math.huge
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			closest = math.min(closest, (root.Position - spot.position).Magnitude)
		end
	end
	return closest - spot.minDistance
end

-- Prepara il modulo con le postazioni del layout. Chiamalo una volta all'avvio.
function Apparition.init(layoutSpots: { Spot }, parent: Instance, random: Random)
	spots = layoutSpots
	folder = parent
	rng = random
end

-- Durante un blackout o un'interruzione: decide con probabilita' se mostrare la sagoma, in un momento casuale del buio.
function Apparition.duringDark(kind: string, duration: number)
	local chance = if kind == "blackout" then Config.Apparition.BlackoutChance else Config.Apparition.CutChance
	if rng:NextNumber() > chance then
		return
	end
	if not Rules.cooldownReady(lastShownAt, os.clock(), Config.Apparition.GlobalCooldown) then
		return
	end

	local distances = {}
	for index, spot in spots do
		distances[index] = margins(spot)
	end
	local index = Rules.pickSpot(rng, distances, 0)
	if not index then
		return
	end

	lastShownAt = os.clock()
	local at = Rules.randomBetween(rng, 0.35, 0.75) * duration
	local length = Rules.randomBetween(rng, 0.6, 1.1)
	local gen = generation
	task.delay(at, show, spots[index].position, length, gen)
end

-- Sagoma dietro il vetro con le luci accese: rarissima e molto breve, solo se nessuno e' vicino alla postazione.
function Apparition.glimpse()
	local index = nil
	for i, spot in spots do
		if spot.name == "glass" then
			index = i
		end
	end
	if not index then
		return
	end
	if margins(spots[index]) < 0 then
		return
	end
	lastShownAt = os.clock()
	show(spots[index].position, Rules.randomBetween(rng, 0.35, 0.5), generation)
end

-- Rimuove la sagoma e annulla quelle programmate: si chiama appena le luci tornano.
function Apparition.clear()
	generation += 1
	clearFigure()
end

return Apparition
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">DataService</string>
        <string name="Source"><![CDATA[--!strict
--[[
	DataService.lua — profilo persistente di ogni giocatore con ProfileStore (session lock, salvataggi periodici,
	protezione da duplicazioni tra server). Unico punto di accesso ai dati salvati.
	Oggi: impostazioni. Lo schema contiene gia' economia e statistiche per le milestone 10-12,
	cosi' i profili non andranno migrati.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("LIGHTS")
local Config = require(shared:WaitForChild("Config"))
local Net = require(shared:WaitForChild("Net"))
local ProfileStore = require(script.Parent.Packages.ProfileStore)

local DataService = {}

local TEMPLATE = {
	Version = 1,
	Coins = 0,
	XP = 0,
	Level = 1,
	Wins = 0,
	Score = 0,
	Stats = { Matches = 0, Escapes = 0, Deaths = 0, Objectives = 0 },
	Inventory = {}, -- [itemId] = true
	Equipped = {},
	Achievements = {},
	Receipts = {}, -- PurchaseId gia' accreditati (anti-duplicazione Developer Products)
	Settings = table.clone(Config.SettingsDefaults),
}

local store = ProfileStore.New("LIGHTS_Player_v1", TEMPLATE)
local profiles: { [Player]: any } = {}

-- Tiene solo le impostazioni note con il tipo giusto; i volumi sono interi 0..10.
local function sanitizeSettings(input: any): { [string]: any }
	local clean = table.clone(Config.SettingsDefaults)
	if typeof(input) ~= "table" then
		return clean
	end
	for key, default in Config.SettingsDefaults do
		local value = input[key]
		if typeof(value) == typeof(default) then
			clean[key] = if typeof(default) == "number" then math.clamp(math.floor(value), 0, 10) else value
		end
	end
	return clean
end

local function onPlayerAdded(player: Player)
	local profile = store:StartSessionAsync("user_" .. player.UserId, {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})
	if not profile then
		-- Sessione non ottenibile (DataStore in errore o giocatore uscito): meglio rientrare che giocare senza salvataggi.
		player:Kick("Impossibile caricare i tuoi dati. Riprova tra poco.")
		return
	end
	profile:AddUserId(player.UserId) -- GDPR
	profile:Reconcile()
	profile.Data.Settings = sanitizeSettings(profile.Data.Settings)
	profile.OnSessionEnd:Connect(function()
		profiles[player] = nil
		player:Kick("Sessione dati chiusa da un altro server. Rientra nel gioco.")
	end)
	if player.Parent == Players then
		profiles[player] = profile
	else
		profile:EndSession()
	end
end

-- Profilo attivo del giocatore (nil finche' non e' caricato).
function DataService.get(player: Player): any?
	return profiles[player]
end

-- Attende il profilo fino a timeout secondi.
function DataService.wait(player: Player, timeout: number): any?
	local waited = 0
	while not profiles[player] and waited < timeout and player.Parent == Players do
		task.wait(0.1)
		waited += 0.1
	end
	return profiles[player]
end

function DataService.init()
	Net.func("GetSettings").OnServerInvoke = function(player: Player)
		local profile = DataService.wait(player, 10)
		return if profile then profile.Data.Settings else table.clone(Config.SettingsDefaults)
	end
	Net.event("SetSettings").OnServerEvent:Connect(function(player: Player, input: any)
		local profile = profiles[player]
		if profile then
			profile.Data.Settings = sanitizeSettings(input)
		end
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		local profile = profiles[player]
		profiles[player] = nil
		if profile then
			profile:EndSession()
		end
	end)
end

return DataService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">Events</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Events.lua — eventi casuali di contorno: porta che si chiude da sola, ombra che attraversa un corridoio,
	monitor che si disturba per un istante, sagoma dietro il vetro (la piu' rara).
	Ogni evento ha il suo cooldown; un evento non parte se un giocatore e' troppo vicino.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("LIGHTS")
local Config = require(shared:WaitForChild("Config"))
local Rules = require(shared:WaitForChild("Rules"))
local Net = require(shared:WaitForChild("Net"))
local Lights = require(script.Parent.Lights)
local Apparition = require(script.Parent.Apparition)

local Events = {}

local OPEN_ANGLE = -1.2 -- stessa apertura iniziale della porta nel Builder
local rng: Random
local folder: Instance
local visuals: RemoteEvent
local doorRef: { part: Part, hinge: CFrame }? = nil
local shadowPaths: { { from: Vector3, to: Vector3 } } = {}
local monitorList: { Part } = {}
local lastAt: { [string]: number } = {}
local lastAny: number? = nil

-- Vero se un giocatore e' entro "radius" studs dal punto.
local function playerNear(position: Vector3, radius: number): boolean
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and (root.Position - position).Magnitude < radius then
			return true
		end
	end
	return false
end

-- Porta ruotata sulla cerniera: si chiude piano; se un giocatore si avvicina torna indietro.
local function swingDoor(door: Part, hinge: CFrame)
	local angle = Instance.new("NumberValue")
	angle.Value = OPEN_ANGLE
	angle.Parent = folder
	local connection = angle.Changed:Connect(function()
		door.CFrame = hinge * CFrame.Angles(0, angle.Value, 0) * CFrame.new(3, 3.5, 0)
	end)

	local function reopen()
		local tween = TweenService:Create(angle, TweenInfo.new(6, Enum.EasingStyle.Sine), { Value = OPEN_ANGLE })
		tween.Completed:Connect(function()
			connection:Disconnect()
			angle:Destroy()
		end)
		tween:Play()
	end

	local closing = TweenService:Create(angle, TweenInfo.new(9, Enum.EasingStyle.Sine), { Value = 0 })
	local guard: RBXScriptConnection? = nil
	guard = RunService.Heartbeat:Connect(function()
		if closing.PlaybackState == Enum.PlaybackState.Playing and playerNear(door.Position, 8) then
			closing:Cancel()
			if guard then
				guard:Disconnect()
			end
		end
	end)
	closing.Completed:Connect(function(state: Enum.PlaybackState)
		if guard then
			guard:Disconnect()
		end
		if state == Enum.PlaybackState.Completed then
			task.delay(4, reopen)
		else
			reopen()
		end
	end)
	Lights.playAt(door, Config.Sounds.Door, 0.6)
	closing:Play()
end

-- Ombra scura e semitrasparente che attraversa uno dei percorsi della lobby in pochi secondi.
local function crossShadow()
	if #shadowPaths == 0 then
		return
	end
	local path = shadowPaths[rng:NextInteger(1, #shadowPaths)]
	local reverse = rng:NextNumber() < 0.5
	local from = if reverse then path.to else path.from
	local to = if reverse then path.from else path.to
	local facing = CFrame.lookAt(from, to)

	local shadow = Instance.new("Part")
	shadow.Name = "Shadow"
	shadow.Anchored = true
	shadow.CanCollide = false
	shadow.CanQuery = false
	shadow.CanTouch = false
	shadow.CastShadow = false
	shadow.Material = Enum.Material.SmoothPlastic
	shadow.Color = Color3.fromRGB(4, 4, 5)
	shadow.Transparency = 1
	shadow.Size = Vector3.new(2.2, 6.5, 0.3)
	shadow.CFrame = facing
	shadow.Parent = folder

	local info = TweenInfo.new(1.6, Enum.EasingStyle.Linear)
	TweenService:Create(shadow, TweenInfo.new(0.25), { Transparency = 0.7 }):Play()
	TweenService:Create(shadow, info, { CFrame = facing + (to - from) }):Play()
	task.delay(1.3, function()
		TweenService:Create(shadow, TweenInfo.new(0.3), { Transparency = 1 }):Play()
	end)
	task.delay(2, function()
		shadow:Destroy()
	end)
end

-- Il monitor si disturba per un istante: il client disegna la statica, qui si manda solo il segnale.
local function monitorStatic()
	local monitors = monitorList
	if #monitors == 0 then
		return
	end
	local monitor = monitors[rng:NextInteger(1, #monitors)]
	visuals:FireAllClients("static", monitor)
	Lights.playAt(monitor, Config.Sounds.Static, 0.35)
end

-- Sceglie e avvia un evento, rispettando cooldown e distanza dai giocatori. Restituisce il nome se e' partito.
local function tryEvent(name: string): string?
	local now = os.clock()
	if name == "door" then
		local door = doorRef
		if not door or playerNear(door.part.Position, 14) then
			return nil
		end
		swingDoor(door.part, door.hinge)
	elseif name == "shadow" then
		crossShadow()
	elseif name == "monitor" then
		monitorStatic()
	end
	lastAt[name] = now
	lastAny = now
	return name
end

-- Programma gli eventi a intervalli casuali. Ogni tick sceglie al massimo un evento.
function Events.run()
	while true do
		task.wait(Rules.randomBetween(rng, Config.Events.TickMin, Config.Events.TickMax))
		local now = os.clock()
		if not Rules.cooldownReady(lastAny, now, Config.Events.GlobalCooldown) then
			continue
		end

		if rng:NextNumber() < Config.Events.GlimpseChance and Rules.cooldownReady(lastAt.glimpse, now, Config.Events.GlimpseCooldown) then
			Apparition.glimpse()
			lastAt.glimpse = now
			lastAny = now
			continue
		end

		local entries = {
			{ name = "door", weight = if Rules.cooldownReady(lastAt.door, now, Config.Events.DoorCooldown) then 3 else 0 },
			{ name = "shadow", weight = if Rules.cooldownReady(lastAt.shadow, now, Config.Events.ShadowCooldown) then 3 else 0 },
			{ name = "monitor", weight = if Rules.cooldownReady(lastAt.monitor, now, Config.Events.MonitorCooldown) then 2 else 0 },
			{ name = "none", weight = 3 },
		}
		local picked = Rules.pickWeighted(rng, entries)
		if picked and picked ~= "none" then
			tryEvent(picked)
		end
	end
end

-- Prepara gli eventi con la porta e i monitor del layout.
function Events.init(door: { part: Part, hinge: CFrame }?, monitors: { Part }, paths: { { from: Vector3, to: Vector3 } }, parent: Instance, random: Random)
	doorRef = door
	shadowPaths = paths
	monitorList = monitors
	folder = parent
	rng = random
	visuals = Net.event("LightsEvent")
end

return Events
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">Geometry</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Geometry.lua — mattoni per costruire la lobby: blocchi, tubi, cartelli, apparecchi luce.
	Tutto e' Part reali con Material e Color (nessun asset esterno necessario).
]]

local Lighting = game:GetService("Lighting")

local Geometry = {}

-- Piccola variazione di tono, cosi' le superfici non sembrano tutte uguali.
function Geometry.jitter(color: Color3, rng: Random): Color3
	local k = 0.92 + rng:NextNumber() * 0.12
	return Color3.new(math.clamp(color.R * k, 0, 1), math.clamp(color.G * k, 0, 1), math.clamp(color.B * k, 0, 1))
end

-- Blocco ancorato tra due angoli a e b (coordinate di mondo).
function Geometry.block(parent: Instance, a: Vector3, b: Vector3, material: Enum.Material, color: Color3): Part
	local lo = Vector3.new(math.min(a.X, b.X), math.min(a.Y, b.Y), math.min(a.Z, b.Z))
	local hi = Vector3.new(math.max(a.X, b.X), math.max(a.Y, b.Y), math.max(a.Z, b.Z))
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = hi - lo
	p.CFrame = CFrame.new((lo + hi) / 2)
	p.Material = material
	p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Tubo orizzontale lungo X (asse del cilindro) centrato in center.
function Geometry.pipeX(parent: Instance, center: Vector3, length: number, radius: number, color: Color3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, radius * 2, radius * 2)
	p.CFrame = CFrame.new(center)
	p.Material = Enum.Material.Metal
	p.Color = color
	p.Parent = parent
	return p
end

-- Tubo orizzontale lungo Z.
function Geometry.pipeZ(parent: Instance, center: Vector3, length: number, radius: number, color: Color3): Part
	local p = Geometry.pipeX(parent, center, length, radius, color)
	p.CFrame = CFrame.new(center) * CFrame.Angles(0, math.pi / 2, 0)
	return p
end

-- Orientamento di una faccia: la faccia "Front" del Part guarda verso normal.
function Geometry.facing(pos: Vector3, normal: Vector3): CFrame
	return CFrame.lookAt(pos, pos + normal)
end

-- Cartello con testo su una faccia. Il Part e' sottile e ancorato alla parete.
function Geometry.sign(parent: Instance, pos: Vector3, normal: Vector3, size: Vector2, text: string,
	style: { background: Color3, foreground: Color3, font: Enum.Font, textSize: number })
	local part = Instance.new("Part")
	part.Anchored = true
	part.Size = Vector3.new(size.X, size.Y, 0.3)
	part.CFrame = Geometry.facing(pos, normal)
	part.Material = Enum.Material.SmoothPlastic
	part.Color = style.background
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = parent

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.2
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = style.foreground
	label.Font = style.font
	label.TextScaled = true
	label.Parent = gui

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = style.textSize
	constraint.Parent = label

	return part
end

-- Apparecchio luce a soffitto: un tubo "housing" (che si accende e spegne) + una PointLight.
-- Lights.lua decide quando accendere/spegnere; qui si crea solo la geometria.
function Geometry.fixture(parent: Instance, pos: Vector3, rng: Random, range: number): (Part, PointLight)
	local housing = Instance.new("Part")
	housing.Anchored = true
	housing.CanCollide = false
	housing.CanTouch = false
	housing.CanQuery = false
	housing.CastShadow = false
	housing.Size = Vector3.new(5, 0.4, 1.1)
	housing.CFrame = CFrame.new(pos)
	housing.Material = Enum.Material.Neon
	housing.Color = Color3.fromRGB(220, 240, 232)
	housing.Parent = parent

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(214, 238, 228)
	light.Range = range
	light.Brightness = 1.1
	light.Shadows = false
	light.Parent = housing

	return housing, light
end

-- Chiude l'illuminazione per tutta la lobby: buio di base, nebbia leggera, bagliore e cromatura fredda.
function Geometry.setupLighting()
	-- Nota: Lighting.Technology non si cambia da script; impostalo in Studio (consigliato ShadowMap per mobile/console).
	Lighting.Ambient = Color3.fromRGB(12, 13, 16)
	Lighting.OutdoorAmbient = Color3.fromRGB(8, 9, 11)
	Lighting.Brightness = 0.4
	Lighting.FogColor = Color3.fromRGB(6, 7, 9)
	Lighting.FogStart = 60
	Lighting.FogEnd = 240

	local function ensure(className: string): Instance
		local existing = Lighting:FindFirstChildOfClass(className :: any)
		if existing then
			return existing
		end
		local created = Instance.new(className :: any)
		created.Parent = Lighting
		return created
	end

	local atmosphere = ensure("Atmosphere") :: Atmosphere
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(70, 78, 86)
	atmosphere.Haze = 1.6

	local bloom = ensure("BloomEffect") :: BloomEffect
	bloom.Intensity = 0.55
	bloom.Size = 18
	bloom.Threshold = 0.95

	local color = ensure("ColorCorrectionEffect") :: ColorCorrectionEffect
	color.Brightness = -0.04
	color.Contrast = 0.2
	color.Saturation = -0.85
	color.TintColor = Color3.fromRGB(205, 222, 240)
end

return Geometry
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">Lights</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Lights.lua — sistema delle luci (solo server; lo stato delle Part e delle PointLight si replica da solo).
	- Ogni lampada lampeggia in modo irregolare; alcune sono "malate" e lampeggiano di piu'.
	- Ogni tanto la corrente salta: breve interruzione o blackout generale (raro).
	- Al ritorno le lampade si riaccendono con ritardo casuale; a volte una ripete il lampeggio.
	- Passarci sotto spegne per un attimo la lampada.
	Gli eventi importanti vengono inviati ai client (LightsEvent) per sincronizzare logo e monitor.
]]

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("LIGHTS")
local Config = require(shared:WaitForChild("Config"))
local Rules = require(shared:WaitForChild("Rules"))
local Net = require(shared:WaitForChild("Net"))

local Lights = {}

export type Lamp = { housing: Part, light: PointLight, trigger: Part? }
export type Fixture = {
	housing: Part,
	light: PointLight,
	trigger: Part?,
	buzz: Sound?,
	litColor: Color3, -- colore da accesa (bianco freddo o rosso per le barre della baia)
	powered: boolean, -- la corrente arriva a questa lampada
	lit: boolean, -- stato del lampeggio
	forced: number, -- quante cause la tengono spenta (es. un giocatore ci passa sotto)
	unstable: boolean, -- lampada "malata"
	lastTrigger: number?,
}

local OFF_COLOR = Color3.fromRGB(52, 54, 56)
local DARK_AMBIENT = Color3.fromRGB(3, 3, 4)

local fixtures: { Fixture } = {}
local rng: Random
local event: RemoteEvent
local baseAmbient: Color3

-- Gruppi audio controllabili dalle impostazioni del client (volume musica / effetti).
Lights.groups = {}

-- Crea un Sound solo se l'ID e' configurato: senza ID il suono viene saltato, nessun errore.
local function makeSound(parent: Instance, id: string, volume: number, group: SoundGroup?, looped: boolean): Sound?
	if id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.Looped = looped
	sound.RollOffMaxDistance = 40
	if group then
		sound.SoundGroup = group
	end
	sound.Parent = parent
	return sound
end

-- Suono una tantum posizionato nello spazio 3D vicino a una lampada.
local function playAt(part: BasePart, id: string, volume: number)
	local sound = makeSound(part, id, volume, Lights.groups.Effects, false)
	if sound then
		sound:Play()
		Debris:AddItem(sound, 12)
	end
end

-- Applica lo stato reale a una lampada: accesa solo se riceve corrente, e' nel suo lampeggio attivo e non e' forzata spenta.
local function apply(f: Fixture)
	local on = f.powered and f.lit and f.forced == 0
	f.light.Enabled = on
	f.housing.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	f.housing.Color = if on then f.litColor else OFF_COLOR
	if f.buzz then
		if on and not f.buzz.IsPlaying then
			f.buzz:Play()
		elseif not on and f.buzz.IsPlaying then
			f.buzz:Stop()
		end
	end
end

local function setPowered(f: Fixture, value: boolean)
	f.powered = value
	apply(f)
end

-- Lampeggio irregolare: qualche on/off rapido, poi torna stabile.
local function flicker(f: Fixture)
	if not f.powered then
		return
	end
	local steps = if f.unstable then rng:NextInteger(3, 8) else rng:NextInteger(1, 3)
	for _ = 1, steps do
		f.lit = not f.lit
		apply(f)
		task.wait(Rules.randomBetween(rng, 0.03, 0.16))
	end
	f.lit = true
	apply(f)
end

-- Ciclo di vita di una lampada: lampeggia a intervalli casuali (piu' spesso se malata).
local function runFixture(f: Fixture)
	while true do
		local interval = Rules.randomBetween(rng, Config.Lights.FlickerIntervalMin, Config.Lights.FlickerIntervalMax)
		task.wait(if f.unstable then interval * 0.5 else interval)
		flicker(f)
	end
end

-- Una lampada che riceve un giocatore sotto la colonna trigger si spegne per un attimo.
local function connectTrigger(f: Fixture)
	if not f.trigger then
		return
	end
	f.trigger.Touched:Connect(function(hit: BasePart)
		local model = hit.Parent
		if not model or not model:FindFirstChildOfClass("Humanoid") then
			return
		end
		local now = os.clock()
		if f.forced > 0 or not Rules.cooldownReady(f.lastTrigger, now, 25) then
			return
		end
		f.lastTrigger = now
		f.forced += 1
		apply(f)
		task.delay(Config.Lights.TriggerLampOffTime, function()
			f.forced -= 1
			apply(f)
		end)
	end)
end

local function tweenAmbient(color: Color3, time: number)
	TweenService:Create(Lighting, TweenInfo.new(time, Enum.EasingStyle.Quad), { Ambient = color }):Play()
end

-- Un'interruzione di corrente ("cut" breve o "blackout" generale).
-- onStart/onEnd permettono ad Apparition di agganciarsi al buio senza conoscere le luci.
local function dark(kind: string, duration: number, onStart: (string, number) -> (), onEnd: () -> ())
	event:FireAllClients(kind, duration)
	local sample = fixtures[rng:NextInteger(1, #fixtures)]
	playAt(sample.housing, Config.Sounds.PowerDown, 0.8)
	if kind == "blackout" then
		tweenAmbient(DARK_AMBIENT, 0.4)
		playAt(sample.housing, Config.Sounds.Crackle, 0.6)
	end

	-- Lo spegnimento non e' istantaneo: ogni lampada si spegne con un piccolo sfasamento.
	for _, f in fixtures do
		task.delay(Rules.randomBetween(rng, 0, 0.12), setPowered, f, false)
	end

	onStart(kind, duration)
	task.wait(duration)
	onEnd()

	-- Riaccensione scaglionata; alcune lampade ripetono il lampeggio.
	for _, f in fixtures do
		task.delay(Rules.restoreDelay(rng, Config.Lights.RestoreSpread), function()
			setPowered(f, true)
			if rng:NextNumber() < 0.3 then
				task.spawn(flicker, f)
			end
		end)
	end
	if kind == "blackout" then
		tweenAmbient(baseAmbient, 0.8)
	end
	event:FireAllClients("restore")
	playAt(sample.housing, Config.Sounds.PowerUp, 0.7)
end

-- Crea lo stato delle lampade, i gruppi audio e avvia i cicli di lampeggio.
function Lights.init(lamps: { Lamp }, random: Random)
	rng = random
	event = Net.event("LightsEvent")
	baseAmbient = Lighting.Ambient

	for _, name in { "Ambient", "Effects" } do
		local group = Instance.new("SoundGroup")
		group.Name = "Lights" .. name
		group.Parent = SoundService
		Lights.groups[name] = group
	end

	for _, lamp in lamps do
		local f: Fixture = {
			housing = lamp.housing,
			light = lamp.light,
			trigger = lamp.trigger,
			buzz = makeSound(lamp.housing, Config.Sounds.Buzz, 0.25, Lights.groups.Ambient, true),
			litColor = lamp.housing.Color,
			powered = true,
			lit = true,
			forced = 0,
			unstable = rng:NextNumber() < Config.Lights.UnstableChance,
			lastTrigger = nil,
		}
		table.insert(fixtures, f)
		apply(f)
		connectTrigger(f)
		task.spawn(runFixture, f)
	end
end

-- Ciclo principale degli eventi di luce. Chiama onStart/onEnd attorno ai blackout.
function Lights.run(onStart: (string, number) -> (), onEnd: () -> ())
	if #fixtures == 0 then
		return -- nessuna lampada taggata: niente da far lampeggiare
	end
	local nextBlackoutAt = os.clock()
		+ Rules.randomBetween(rng, Config.Lights.BlackoutMinGap, Config.Lights.BlackoutMaxGap)
	while true do
		task.wait(Rules.randomBetween(rng, Config.Lights.CutIntervalMin, Config.Lights.CutIntervalMax))
		if os.clock() >= nextBlackoutAt then
			nextBlackoutAt = os.clock()
				+ Rules.randomBetween(rng, Config.Lights.BlackoutMinGap, Config.Lights.BlackoutMaxGap)
			dark("blackout", Rules.randomBetween(rng, Config.Lights.BlackoutDurationMin, Config.Lights.BlackoutDurationMax), onStart, onEnd)
		elseif rng:NextNumber() < Config.Lights.BriefCutChance then
			dark("cut", Rules.randomBetween(rng, 0.4, 1.2), onStart, onEnd)
		else
			-- Piccolo sfarfallio su tre lampade a caso
			for _ = 1, 3 do
				task.spawn(flicker, fixtures[rng:NextInteger(1, #fixtures)])
			end
		end
	end
end

-- Esposto per Events (porta, monitor): stesso helper audio, stesso gruppo "Effects".
Lights.playAt = playAt

return Lights
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">LobbyBuilder</string>
        <string name="Source"><![CDATA[--!strict
--[[
	LobbyBuilder.lua — costruisce a runtime la lobby di LIGHTS: un hangar di ricerca/contenimento dismesso.
	Coordinate (y = 0 pavimento):
	- Hangar: X[-60,60] Z[-45,45], soffitto y=34. Spawn a sud (Z=32), guarda verso l'insegna al centro.
	- Centro: basamento con grata e insegna LIGHTS sospesa alle capriate (y=17), leggibile da entrambi i lati.
	- Nord: ballatoio a y=12 con scala (lato ovest) e sala controllo vetrata (sagoma dietro il vetro).
	- Est: baia di partenza, 4 porte blindate con barra rossa e monitor della coda.
	- Ovest: area informazioni (bacheca, rapporto) e porta di servizio verso uno stanzino buio.
	build() crea la lobby (in Studio con bake(), o a runtime se manca); collect() la rilegge da tag e marcatori.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("LIGHTS"):WaitForChild("Config"))
local Geometry = require(script.Parent.Geometry)

local LobbyBuilder = {}

local CONCRETE = Color3.fromRGB(88, 90, 92)
local CONCRETE_DARK = Color3.fromRGB(58, 60, 62)
local STEEL = Color3.fromRGB(46, 48, 52)
local RUST = Color3.fromRGB(74, 52, 40)
local ACCENT_RED = Color3.fromRGB(92, 18, 20)
local WOOD = Color3.fromRGB(92, 66, 44)
local BLACK = Color3.fromRGB(10, 10, 12)
local GLASS = Color3.fromRGB(150, 165, 175)
local WINDOW = Color3.fromRGB(205, 214, 218)
local RED_LIGHT = Color3.fromRGB(255, 40, 40)

export type Lamp = { housing: Part, light: PointLight, trigger: Part? }
export type Spot = { name: string, position: Vector3, minDistance: number }
export type Layout = {
	folder: Folder,
	lamps: { Lamp },
	monitors: { Part },
	deployScreens: { TextLabel },
	door: { part: Part, hinge: CFrame }?,
	shadowPaths: { { from: Vector3, to: Vector3 } },
	spots: { Spot },
}

-- Seed fisso: la lobby e' sempre uguale, sia costruita in Studio sia a runtime.
LobbyBuilder.SEED = 20261102

-- Crea un valore figlio (riferimenti che i tag da soli non possono esprimere).
local function valueChild(className: string, name: string, value: any, parent: Instance)
	local v = Instance.new(className) :: any
	v.Name = name
	v.Value = value
	v.Parent = parent
end

function LobbyBuilder.build(rng: Random): Folder
	local folder = Instance.new("Folder")
	folder.Name = "LIGHTS_Lobby"
	folder.Parent = workspace

	local function block(a: Vector3, b: Vector3, color: Color3?, material: Enum.Material?): Part
		return Geometry.block(folder, a, b, material or Enum.Material.Concrete, Geometry.jitter(color or CONCRETE, rng))
	end
	-- Parte decorativa: niente collisioni ne' query, per non disturbare movimento e raycast.
	local function prop(a: Vector3, b: Vector3, color: Color3, material: Enum.Material): Part
		local p = block(a, b, color, material)
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		return p
	end

	local function addLamp(housing: Part, light: PointLight, trigger: Part?)
		CollectionService:AddTag(housing, "LightsLamp")
		if trigger then
			valueChild("ObjectValue", "Trigger", trigger, housing)
		end
	end
	-- Lampada a campana appesa a un cavo (come nei riferimenti). Il bulbo e' la parte che si accende.
	local function pendant(x: number, z: number, y: number, trigger: boolean)
		prop(Vector3.new(x - 0.06, y + 1.2, z - 0.06), Vector3.new(x + 0.06, 34, z + 0.06), BLACK, Enum.Material.SmoothPlastic)
		local shade = Instance.new("Part")
		shade.Anchored = true
		shade.CanCollide = false
		shade.CanQuery = false
		shade.Shape = Enum.PartType.Cylinder
		shade.Size = Vector3.new(0.9, 2.6, 2.6)
		shade.CFrame = CFrame.new(x, y + 0.7, z) * CFrame.Angles(0, 0, math.pi / 2)
		shade.Material = Enum.Material.Metal
		shade.Color = STEEL
		shade.Parent = folder
		local bulb, light = Geometry.fixture(folder, Vector3.new(x, y, z), rng, 34)
		bulb.Shape = Enum.PartType.Ball
		bulb.Size = Vector3.new(0.9, 0.9, 0.9)
		local column: Part? = nil
		if trigger then
			local t = Instance.new("Part")
			t.Anchored = true
			t.CanCollide = false
			t.CanQuery = false
			t.Transparency = 1
			t.Size = Vector3.new(6, 10, 6)
			t.CFrame = CFrame.new(x, 5, z)
			t.Parent = folder
			column = t
		end
		addLamp(bulb, light, column)
	end
	-- Plafoniera a tubo (sotto il ballatoio, stanze di servizio).
	local function tube(pos: Vector3, range: number)
		local housing, light = Geometry.fixture(folder, pos, rng, range)
		addLamp(housing, light, nil)
	end

	-- ================= Involucro =================
	block(Vector3.new(-62, -2, -47), Vector3.new(62, 0, 47)) -- pavimento
	block(Vector3.new(-62, 34, -47), Vector3.new(62, 36, 47), CONCRETE_DARK) -- soffitto
	block(Vector3.new(-62, 0, -47), Vector3.new(62, 34, -45)) -- muro nord
	block(Vector3.new(-62, 0, 45), Vector3.new(62, 34, 47)) -- muro sud
	block(Vector3.new(60, 0, -45), Vector3.new(62, 34, 45)) -- muro est (baia di partenza)
	-- Muro ovest con l'apertura della porta di servizio (Z[14,20], alta 7)
	block(Vector3.new(-62, 0, -45), Vector3.new(-60, 34, 14))
	block(Vector3.new(-62, 0, 20), Vector3.new(-60, 34, 45))
	block(Vector3.new(-62, 7, 14), Vector3.new(-60, 34, 20))
	-- Zoccolo scuro sporco lungo i muri: sporcizia e umidita' alla base
	for _, wall in {
		{ Vector3.new(-60, 0, -45), Vector3.new(60, 2.5, -44.8) },
		{ Vector3.new(-60, 0, 44.8), Vector3.new(60, 2.5, 45) },
		{ Vector3.new(59.8, 0, -45), Vector3.new(60, 2.5, 45) },
	} do
		prop(wall[1], wall[2], CONCRETE_DARK, Enum.Material.Concrete)
	end

	-- Finestre a nastro alte (est e ovest): luce fredda e lattiginosa, telaio scuro
	for _, side in { -1, 1 } do
		local x = side * 59.9
		for z = -40, 32, 12 do
			local pane = prop(Vector3.new(x - 0.1, 24, z), Vector3.new(x + 0.1, 30, z + 9), WINDOW, Enum.Material.Neon)
			pane.Transparency = 0.15
			local surface = Instance.new("SurfaceLight")
			surface.Face = if side < 0 then Enum.NormalId.Right else Enum.NormalId.Left
			surface.Brightness = 0.6
			surface.Range = 40
			surface.Angle = 70
			surface.Color = Color3.fromRGB(200, 214, 225)
			surface.Shadows = true
			surface.Parent = pane
			for mz = z, z + 9, 1.5 do
				prop(Vector3.new(x - 0.25, 24, mz - 0.08), Vector3.new(x + 0.25, 30, mz + 0.08), BLACK, Enum.Material.Metal)
			end
			prop(Vector3.new(x - 0.25, 26.9, z), Vector3.new(x + 0.25, 27.1, z + 9), BLACK, Enum.Material.Metal)
		end
	end

	-- Capriate del tetto
	for _, z in { -30, -10, 10, 30 } do
		prop(Vector3.new(-60, 30.6, z - 0.4), Vector3.new(60, 31.4, z + 0.4), STEEL, Enum.Material.Metal)
		prop(Vector3.new(-60, 33.2, z - 0.3), Vector3.new(60, 33.8, z + 0.3), STEEL, Enum.Material.Metal)
		for x = -55, 55, 10 do
			prop(Vector3.new(x - 0.2, 31.4, z - 0.2), Vector3.new(x + 0.2, 33.2, z + 0.2), STEEL, Enum.Material.Metal)
		end
	end

	-- Pilastri con fascia rossa (accento dei riferimenti)
	for _, x in { -30, 30 } do
		for _, z in { -30, -10, 10, 30 } do
			block(Vector3.new(x - 2, 0, z - 2), Vector3.new(x + 2, 34, z + 2))
			prop(Vector3.new(x - 2.05, 0, z + 0.6), Vector3.new(x + 2.05, 9, z + 1.4), ACCENT_RED, Enum.Material.Concrete)
		end
	end

	-- Tubature lungo i muri e una calata verticale
	Geometry.pipeZ(folder, Vector3.new(-58.8, 21, 0), 90, 0.7, RUST)
	Geometry.pipeZ(folder, Vector3.new(-58.8, 19.4, 0), 90, 0.35, STEEL)
	Geometry.pipeZ(folder, Vector3.new(58.8, 21, 0), 90, 0.7, RUST)
	Geometry.pipeX(folder, Vector3.new(0, 22, 44), 120, 0.5, STEEL)
	local drop = Geometry.pipeX(folder, Vector3.new(-58.8, 10.5, -20), 21, 0.35, STEEL)
	drop.CFrame = CFrame.new(-58.8, 10.5, -20) * CFrame.Angles(0, 0, math.pi / 2)

	-- Macchie e pozzanghere sul pavimento (riflessi)
	for _ = 1, 14 do
		local x, z = rng:NextNumber(-55, 55), rng:NextNumber(-40, 40)
		local w, d = rng:NextNumber(3, 9), rng:NextNumber(3, 8)
		local stain = prop(Vector3.new(x, 0, z), Vector3.new(x + w, 0.03, z + d), Color3.fromRGB(30, 31, 30), Enum.Material.Concrete)
		stain.Transparency = 0.55
	end
	for _, spec in { { -18, 6, 7, 4 }, { 14, -14, 5, 3 }, { 38, 22, 4, 6 } } do
		local puddle = prop(Vector3.new(spec[1], 0, spec[2]), Vector3.new(spec[1] + spec[3], 0.04, spec[2] + spec[4]), Color3.fromRGB(26, 30, 34), Enum.Material.Glass)
		puddle.Transparency = 0.45
		puddle.Reflectance = 0.35
	end

	-- ================= Centro: basamento e insegna LIGHTS =================
	local plinth = Instance.new("Part")
	plinth.Anchored = true
	plinth.Shape = Enum.PartType.Cylinder
	plinth.Size = Vector3.new(0.6, 18, 18)
	plinth.CFrame = CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, math.pi / 2)
	plinth.Material = Enum.Material.Concrete
	plinth.Color = CONCRETE_DARK
	plinth.Parent = folder
	local grate = plinth:Clone()
	grate.Size = Vector3.new(0.62, 10, 10)
	grate.Material = Enum.Material.DiamondPlate
	grate.Color = STEEL
	grate.Parent = folder

	local sign = Instance.new("Part")
	sign.Name = "LogoPanel"
	sign.Anchored = true
	sign.CanCollide = false
	sign.Size = Vector3.new(30, 7, 0.6)
	sign.CFrame = Geometry.facing(Vector3.new(0, 17, 0), Vector3.new(0, 0, 1))
	sign.Material = Enum.Material.Metal
	sign.Color = BLACK
	sign.Parent = folder
	CollectionService:AddTag(sign, "LightsLogo")
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 50
		gui.LightInfluence = 0
		gui.Parent = sign
		for index, letter in { "L", "I", "G", "H", "T", "S" } do
			local label = Instance.new("TextLabel")
			label.Name = "LogoLetter" .. index
			label.BackgroundTransparency = 1
			label.Size = UDim2.fromScale(0.13, 0.62)
			label.Position = UDim2.fromScale(0.0225 + (index - 1) * 0.165, 0.19)
			label.Text = letter
			label.Font = Enum.Font.Michroma
			label.TextScaled = true
			label.TextColor3 = Color3.fromRGB(240, 246, 252)
			label.TextStrokeColor3 = Color3.fromRGB(230, 240, 255)
			label.TextStrokeTransparency = 0.55
			label.Parent = gui
		end
	end
	for _, x in { -13, 13 } do -- cavi di sospensione
		prop(Vector3.new(x - 0.05, 20.5, -0.05), Vector3.new(x + 0.05, 30.6, 0.05), BLACK, Enum.Material.SmoothPlastic)
	end
	local signTube, signLight = Geometry.fixture(folder, Vector3.new(0, 13.2, 0), rng, 20)
	signTube.Size = Vector3.new(26, 0.3, 0.3)
	addLamp(signTube, signLight, nil)

	-- Lampade a campana sulla sala (la fila centrale ha il trigger "spegni passando sotto")
	for _, x in { -45, -15, 15, 45 } do
		for _, z in { -22, 2, 26 } do
			pendant(x, z, 22, z == 2 and (x == -15 or x == 15))
		end
	end

	-- ================= Spawn e panche =================
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, 0.5, 32)
	spawn.Parent = folder
	local function bench(x: number, z: number)
		block(Vector3.new(x - 4, 1.6, z - 0.9), Vector3.new(x + 4, 1.9, z + 0.9), WOOD, Enum.Material.WoodPlanks)
		for _, lx in { x - 3.6, x + 3.6 } do
			block(Vector3.new(lx - 0.15, 0, z - 0.8), Vector3.new(lx + 0.15, 1.6, z + 0.8), STEEL, Enum.Material.Metal)
		end
	end
	bench(-16, 22)
	bench(16, 22)
	bench(-44, 12)
	bench(44, -2)

	-- ================= Nord: ballatoio, scala, sala controllo =================
	block(Vector3.new(-60, 11, -45), Vector3.new(60, 12, -33), STEEL, Enum.Material.DiamondPlate)
	for x = -58, 58, 12 do -- travi di sostegno
		block(Vector3.new(x - 0.5, 0, -33.6), Vector3.new(x + 0.5, 11, -32.6), STEEL, Enum.Material.Metal)
	end
	for x = -60, 60, 4 do -- ringhiera, con il varco dell'arrivo della scala (X[-54,-48])
		if x < -54 or x > -48 then
			prop(Vector3.new(x - 0.08, 12, -33.1), Vector3.new(x + 0.08, 15.4, -32.9), BLACK, Enum.Material.Metal)
		end
	end
	block(Vector3.new(-60, 15.2, -33.15), Vector3.new(-54, 15.5, -32.85), BLACK, Enum.Material.Metal)
	block(Vector3.new(-48, 15.2, -33.15), Vector3.new(60, 15.5, -32.85), BLACK, Enum.Material.Metal)
	for step = 1, 12 do -- scala dal pavimento al ballatoio (lato ovest)
		block(Vector3.new(-54, 0, -21 - step), Vector3.new(-48, step, -20 - step), STEEL, Enum.Material.DiamondPlate)
	end
	for x = -40, 40, 16 do
		tube(Vector3.new(x, 10.4, -39), 18) -- plafoniere sotto il ballatoio
	end

	-- Sala controllo vetrata sul ballatoio: X[10,30], Z[-45,-36], y 12..20
	block(Vector3.new(9, 12, -45), Vector3.new(10, 21, -36))
	block(Vector3.new(30, 12, -45), Vector3.new(31, 21, -36))
	block(Vector3.new(9, 20, -45), Vector3.new(31, 21, -36), CONCRETE_DARK)
	block(Vector3.new(10, 12, -36.5), Vector3.new(30, 14.5, -36))
	block(Vector3.new(10, 18.5, -36.5), Vector3.new(30, 20, -36))
	block(Vector3.new(10, 12, -36.5), Vector3.new(13, 20, -36)) -- montante ovest: la sala e' chiusa, si vede solo attraverso il vetro
	local glass = Geometry.block(folder, Vector3.new(13, 14.5, -36.4), Vector3.new(30, 18.5, -36.1), Enum.Material.Glass, GLASS)
	glass.Transparency = 0.5
	glass.Reflectance = 0.12
	block(Vector3.new(15, 12, -44), Vector3.new(27, 14.6, -42), STEEL, Enum.Material.Metal) -- console
	tube(Vector3.new(20, 19.4, -41), 12)

	-- Scaffalature e casse sotto il ballatoio
	for x = -36, 36, 12 do
		for shelf = 0, 3 do
			prop(Vector3.new(x - 4, 0.2 + shelf * 2.6, -44.6), Vector3.new(x + 4, 0.4 + shelf * 2.6, -42), STEEL, Enum.Material.Metal)
		end
		for _, px in { x - 4, x + 4 } do
			block(Vector3.new(px - 0.15, 0, -44.6), Vector3.new(px + 0.15, 8.2, -42), STEEL, Enum.Material.Metal)
		end
		if rng:NextNumber() < 0.7 then
			block(Vector3.new(x - 3, 0.4, -44.3), Vector3.new(x - 0.5, 2.6, -42.3), WOOD, Enum.Material.WoodPlanks)
		end
	end

	-- ================= Est: baia di partenza =================
	for index, z in { -24, -8, 8, 24 } do
		block(Vector3.new(57, 0, z - 5), Vector3.new(60, 11, z - 4)) -- spallette
		block(Vector3.new(57, 0, z + 4), Vector3.new(60, 11, z + 5))
		block(Vector3.new(57, 10, z - 4), Vector3.new(60, 11, z + 4))
		block(Vector3.new(59.4, 0, z - 4), Vector3.new(59.8, 10, z + 4), STEEL, Enum.Material.Metal) -- porta blindata
		for y = 1.5, 9, 2.5 do
			prop(Vector3.new(59.2, y, z - 3.6), Vector3.new(59.4, y + 0.2, z + 3.6), BLACK, Enum.Material.Metal)
		end
		-- Barra rossa sopra la porta: e' una lampada (si spegne con i blackout)
		local bar, barLight = Geometry.fixture(folder, Vector3.new(56.8, 11.6, z), rng, 14)
		bar.Size = Vector3.new(0.4, 0.5, 6)
		bar.Color = RED_LIGHT
		barLight.Color = RED_LIGHT
		addLamp(bar, barLight, nil)
		-- Monitor della coda
		local monitor = Instance.new("Part")
		monitor.Name = "LightsMonitor"
		monitor.Anchored = true
		monitor.Size = Vector3.new(4.6, 2.8, 0.8)
		monitor.CFrame = Geometry.facing(Vector3.new(59.5, 13.8, z), Vector3.new(-1, 0, 0)) -- appoggiato al muro
		monitor.Material = Enum.Material.Metal
		monitor.Color = BLACK
		monitor.Parent = folder
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.LightInfluence = 0
		gui.Parent = monitor
		local screen = Instance.new("Frame")
		screen.Name = "Screen"
		screen.Size = UDim2.fromScale(1, 1)
		screen.BackgroundColor3 = Color3.fromRGB(10, 12, 12)
		screen.BorderSizePixel = 0
		screen.Parent = gui
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(0.9, 0.86)
		text.Position = UDim2.fromScale(0.05, 0.07)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.RobotoMono
		text.TextScaled = true
		text.TextColor3 = Color3.fromRGB(205, 220, 210)
		text.TextXAlignment = Enum.TextXAlignment.Left
		text.Text = "BAIA " .. index
		text.Parent = screen
		CollectionService:AddTag(monitor, "LightsMonitor")
		CollectionService:AddTag(text, "LightsDeployScreen")
		text:SetAttribute("Bay", index)
	end
	Geometry.sign(folder, Vector3.new(59.6, 18, 0), Vector3.new(-1, 0, 0), Vector2.new(14, 2.4), "BAIA DI PARTENZA", {
		background = BLACK,
		foreground = Color3.fromRGB(220, 224, 228),
		font = Enum.Font.RobotoMono,
		textSize = 40,
	})

	-- ================= Ovest: area informazioni e porta di servizio =================
	local news = Config.News[1]
	Geometry.sign(folder, Vector3.new(-59.7, 7, -6), Vector3.new(1, 0, 0), Vector2.new(12, 6),
		"AGGIORNAMENTI\n" .. news.Title .. "\n" .. news.Body, {
			background = Color3.fromRGB(16, 17, 19),
			foreground = Color3.fromRGB(232, 236, 240),
			font = Enum.Font.RobotoMono,
			textSize = 26,
		})
	Geometry.sign(folder, Vector3.new(-59.7, 6, 4), Vector3.new(1, 0, 0), Vector2.new(4, 5.2),
		"RAPPORTO 07-C\n\nIl soggetto non tollera la luce.\nAbbiamo spento il settore C per contenerlo.\n\nNessuno ha riacceso il settore C.", {
			background = Color3.fromRGB(214, 208, 192),
			foreground = Color3.fromRGB(30, 28, 26),
			font = Enum.Font.SpecialElite,
			textSize = 18,
		})
	block(Vector3.new(-58, 0, -14), Vector3.new(-52, 3, -11), STEEL, Enum.Material.Metal) -- scrivania
	Geometry.sign(folder, Vector3.new(-59.7, 9.5, 17), Vector3.new(1, 0, 0), Vector2.new(5, 1.3), "SERVIZIO", {
		background = Color3.fromRGB(205, 200, 190),
		foreground = BLACK,
		font = Enum.Font.RobotoMono,
		textSize = 30,
	})

	-- Porta di servizio: cerniera a Z=20, si apre verso la sala. Ruotata di 90° per stare nel muro ovest.
	local hinge = CFrame.new(-61, 0, 20) * CFrame.Angles(0, math.pi / 2, 0)
	local doorPanel = Instance.new("Part")
	doorPanel.Name = "LightsDoor"
	doorPanel.Anchored = true
	doorPanel.Size = Vector3.new(6, 7, 0.4)
	doorPanel.Material = Enum.Material.Metal
	doorPanel.Color = Geometry.jitter(STEEL, rng)
	doorPanel.CFrame = hinge * CFrame.Angles(0, -1.2, 0) * CFrame.new(3, 3.5, 0)
	doorPanel.Parent = folder
	CollectionService:AddTag(doorPanel, "LightsDoor")
	valueChild("CFrameValue", "Hinge", hinge, doorPanel)

	-- Stanzino buio dietro la porta: X[-72,-62] Z[10,24]
	block(Vector3.new(-73, -2, 9), Vector3.new(-62, 0, 25))
	block(Vector3.new(-73, 9, 9), Vector3.new(-62, 10, 25), CONCRETE_DARK)
	block(Vector3.new(-73, 0, 9), Vector3.new(-72, 9, 25))
	block(Vector3.new(-72, 0, 9), Vector3.new(-62, 9, 10))
	block(Vector3.new(-72, 0, 24), Vector3.new(-62, 9, 25))
	tube(Vector3.new(-67, 8.4, 17), 10)

	-- ================= Marcatori (invisibili, spostabili in Studio) =================
	-- Percorsi delle ombre e postazioni delle sagome sono Part invisibili: si possono spostare a mano.
	local markers = Instance.new("Folder")
	markers.Name = "Markers"
	markers.Parent = folder
	local function marker(name: string, position: Vector3, size: Vector3): Part
		local m = Instance.new("Part")
		m.Name = name
		m.Anchored = true
		m.CanCollide = false
		m.CanQuery = false
		m.CanTouch = false
		m.Transparency = 1
		m.Size = size
		m.CFrame = CFrame.new(position)
		m.Parent = markers
		return m
	end
	for _, path in {
		{ Vector3.new(-56, 3.2, -38), Vector3.new(56, 3.2, -38) }, -- sotto il ballatoio
		{ Vector3.new(54, 3.2, -30), Vector3.new(54, 3.2, 30) }, -- davanti alle porte della baia
	} do
		local m = marker("ShadowPath", (path[1] + path[2]) / 2, Vector3.new(1, 1, 1))
		m:SetAttribute("From", path[1])
		m:SetAttribute("To", path[2])
	end
	for _, spot in {
		{ "underMezzanine", Vector3.new(-56, 0, -42), Config.Apparition.MinPlayerDistance },
		{ "serviceRoom", Vector3.new(-69, 0, 13), 30 },
		{ "glass", Vector3.new(22, 12, -40), 16 }, -- dietro il vetro della sala controllo
	} do
		-- Il marcatore e' grande quanto la sagoma: la sua base e' il punto dove compare.
		local m = marker("ApparitionSpot", spot[2] + Vector3.new(0, 4, 0), Vector3.new(2, 8, 1))
		m:SetAttribute("SpotName", spot[1])
		m:SetAttribute("MinDistance", spot[3])
	end

	return folder
end

-- Rilegge il layout da una lobby esistente (costruita ora o salvata nel place e magari modificata a mano).
-- Tutto passa da tag e marcatori: spostare o duplicare lampade e marcatori in Studio funziona senza toccare il codice.
function LobbyBuilder.collect(folder: Instance): Layout
	local lamps: { Lamp } = {}
	local monitors: { Part } = {}
	local screens: { TextLabel } = {}
	local door: { part: Part, hinge: CFrame }? = nil
	local shadowPaths = {}
	local spots: { Spot } = {}
	for _, item in folder:GetDescendants() do
		if item:IsA("Part") and CollectionService:HasTag(item, "LightsLamp") then
			local light = item:FindFirstChildOfClass("PointLight")
			local trigger = item:FindFirstChild("Trigger")
			if light then
				table.insert(lamps, {
					housing = item,
					light = light,
					trigger = if trigger and trigger:IsA("ObjectValue") and trigger.Value and trigger.Value:IsA("Part")
						then trigger.Value
						else nil,
				})
			end
		elseif item:IsA("Part") and CollectionService:HasTag(item, "LightsMonitor") then
			table.insert(monitors, item)
		elseif item:IsA("TextLabel") and CollectionService:HasTag(item, "LightsDeployScreen") then
			table.insert(screens, item)
		elseif item:IsA("Part") and CollectionService:HasTag(item, "LightsDoor") then
			local hinge = item:FindFirstChild("Hinge")
			if hinge and hinge:IsA("CFrameValue") then
				door = { part = item, hinge = hinge.Value }
			end
		elseif item:IsA("BasePart") and item.Name == "ShadowPath" then
			local from, to = item:GetAttribute("From"), item:GetAttribute("To")
			if typeof(from) == "Vector3" and typeof(to) == "Vector3" then
				table.insert(shadowPaths, { from = from, to = to })
			end
		elseif item:IsA("BasePart") and item.Name == "ApparitionSpot" then
			table.insert(spots, {
				name = tostring(item:GetAttribute("SpotName") or "spot"),
				position = item.Position - Vector3.new(0, item.Size.Y / 2, 0),
				minDistance = tonumber(item:GetAttribute("MinDistance")) or Config.Apparition.MinPlayerDistance,
			})
		end
	end
	table.sort(screens, function(a, b)
		return (a:GetAttribute("Bay") or 0) < (b:GetAttribute("Bay") or 0)
	end)
	if #lamps == 0 then
		warn("[LIGHTS] Nessuna lampada con tag LightsLamp in " .. folder:GetFullName() .. ": luci ed eventi disattivati")
	end
	return {
		folder = folder :: Folder,
		lamps = lamps,
		monitors = monitors,
		deployScreens = screens,
		door = door,
		shadowPaths = shadowPaths,
		spots = spots,
	}
end

-- Da eseguire UNA volta dalla Command Bar di Studio, in modalita' Edit:
--   require(game.ServerScriptService.LIGHTS.LobbyBuilder).bake()
-- Costruisce la lobby nel Workspace e imposta l'illuminazione; poi si salva il place (Ctrl+S).
-- Non sovrascrive mai una lobby esistente, per non cancellare modifiche fatte a mano.
function LobbyBuilder.bake(): Folder
	if workspace:FindFirstChild("LIGHTS_Lobby") then
		error("[LIGHTS] Workspace.LIGHTS_Lobby esiste gia'. Eliminalo a mano se vuoi ricostruirlo (perderai le modifiche fatte su di esso).")
	end
	Geometry.setupLighting()
	local folder = LobbyBuilder.build(Random.new(LobbyBuilder.SEED))
	print("[LIGHTS] Lobby costruita in Workspace.LIGHTS_Lobby. Salva il place.")
	return folder
end

return LobbyBuilder
]]></string>
